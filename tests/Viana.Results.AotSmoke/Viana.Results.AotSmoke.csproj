<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Feature 017 (constitution VI): Native AOT smoke test of the core. Published with -r linux-x64 in CI and executed;
    any trim/AOT warning (IL2xxx/IL3xxx) fails the build because warnings are errors.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <IsPackable>false</IsPackable>
    <!-- A RID-specific publish adds runtime/ILCompiler packs that differ by machine: no lock file here. -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Viana.Results\Viana.Results.csproj" />
  </ItemGroup>

</Project>
