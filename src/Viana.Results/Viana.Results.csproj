<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>

		<!-- NuGet package metadata -->
		<PackageId>Viana.Results</PackageId>
		<Title>Viana.Results</Title>
		<Description>Core library for standardized operation results with support for the Result pattern, collections, and pagination.</Description>
		<Authors>Gustavo Viana</Authors>
		<Company>Gustavo Viana</Company>
		<RepositoryUrl>https://github.com/gustavorviana/Viana.Results</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageProjectUrl>https://github.com/gustavorviana/Viana.Results</PackageProjectUrl>
		<PackageTags>result;results;error-handling;pattern;viana</PackageTags>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>

		<!-- Packing configuration -->
		<IsPackable>true</IsPackable>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<Version>2.0.0</Version>
		<PackageReleaseNotes>
			BREAKING: Status and Problem are now [JsonIgnore] on Result/Result&lt;T&gt; — they no longer appear in the serialized response body. Consumers reading these fields from the JSON must use the HTTP status code (Status) and ProblemDetails body (Problem) instead.
			BREAKING: ListResult&lt;T&gt; is now unwrappable — its response body is the inner array, not the wrapper object. PagedResult&lt;T&gt; stays wrapped (keeps PageNumber/TotalPages metadata).
			Fixed a latent bug where IResultData.Data returned null for ListResult&lt;T&gt; (data was never forwarded to the base Result).
			Added ProblemBuilder: a fluent builder for ProblemResult with WithTitle/WithType/WithDescription/WithDetail/WithInstance and AddExtension(s).
			WithDetail and WithInstance map to the RFC 9457 "detail" and "instance" members (stored as extensions until promoted to top-level properties).
		</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
		<PackageReference Include="System.Text.Json" />
	</ItemGroup>

	<ItemGroup>
		<None Include=".\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>
</Project>
