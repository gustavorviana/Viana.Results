<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net6.0;net8.0;net10.0</TargetFrameworks>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>

		<!-- NuGet package metadata -->
		<PackageId>Viana.Results.Mvc</PackageId>
		<Title>Viana.Results.Mvc</Title>
		<Description>ASP.NET Core MVC integration for Viana.Results: a result filter that converts Result/Result&lt;T&gt;/ListResult&lt;T&gt;/PagedResult&lt;T&gt; into native ASP.NET Core responses with the correct HTTP status and RFC 9457 ProblemDetails on errors.</Description>
		<Authors>Gustavo Viana</Authors>
		<Company>Gustavo Viana</Company>
		<RepositoryUrl>https://github.com/gustavorviana/Viana.Results</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageProjectUrl>https://github.com/gustavorviana/Viana.Results</PackageProjectUrl>
		<PackageTags>result;results;aspnetcore;mvc;filters;viana</PackageTags>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>

		<!-- Packing configuration -->
		<IsPackable>true</IsPackable>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<Version>3.0.0</Version>
		<PackageReleaseNotes>
			BREAKING: Removed VianaResultAction. IResult is now translated to native ASP.NET Core results (ObjectResult/StatusCodeResult) by VianaResultFilter and serialized by the framework's own formatters.
			BREAKING: On error, ProblemResult is mapped to Microsoft.AspNetCore.Mvc.ProblemDetails. The "description" member is emitted as the RFC 9457 "detail" member, and error responses use the "application/problem+json" content type (was "application/json").
			Added VianaResultMvcOptions.ProblemContentTypes, configurable via AddVianaResultFilter(o =&gt; ...). Defaults to "application/problem+json"; add "application/problem+xml" to also negotiate XML when an XML formatter is registered.
		</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Viana.Results\Viana.Results.csproj" />
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<None Include=".\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>
