<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net6.0;net8.0;net10.0</TargetFrameworks>
		<LangVersion>latest</LangVersion>

		<!-- NuGet package metadata -->
		<PackageId>Viana.Results.Mvc</PackageId>
		<Title>Viana.Results.Mvc</Title>
		<Description>ASP.NET Core MVC integration for Viana.Results: an ActionResult and filter that serialize Result/Result&lt;T&gt;/ListResult&lt;T&gt;/PagedResult&lt;T&gt; with the correct HTTP status and RFC 9457 problem details on errors.</Description>
		<Authors>Gustavo Viana</Authors>
		<Company>Gustavo Viana</Company>
		<RepositoryUrl>https://github.com/gustavorviana/Viana.Results</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageProjectUrl>https://github.com/gustavorviana/Viana.Results</PackageProjectUrl>
		<PackageTags>result;results;aspnetcore;mvc;filters;viana</PackageTags>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>

		<!-- Packing configuration -->
		<IsPackable>true</IsPackable>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<Version>2.1.0</Version>
		<PackageReleaseNotes>
			Fixed: problem responses use the RFC 9457 media type application/problem+json (was application/json).
			Fixed: a successful typed result with a null value is written as JSON null (was "{}"); a failure with status 204 keeps its problem body (via Viana.Results 3.0.0).
			Improved: bodies are streamed to the response (no intermediate string) and writing stops when the request is aborted. A subclass overriding SerializeToJson keeps working.
			Fixed: calling AddVianaResultFilter more than once registers the filter once.
			Results.Ok() without a value now answers 204 with no body (via Viana.Results).
			Docs: the README shows the package's real API (new VianaResultAction(result)); ToActionResult() belongs to Viana.Results.AspNetCore.
		</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Viana.Results\Viana.Results.csproj" />
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<None Include=".\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>
