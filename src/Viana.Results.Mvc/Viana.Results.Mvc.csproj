<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net6.0;net8.0;net10.0</TargetFrameworks>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>

		<!-- NuGet package metadata -->
		<PackageId>Viana.Results.Mvc</PackageId>
		<Title>Viana.Results.Mvc</Title>
		<Description>ASP.NET Core MVC integration for Viana.Results: an ActionResult and filter that serialize Result/Result&lt;T&gt;/ListResult&lt;T&gt;/PagedResult&lt;T&gt; with the correct HTTP status and RFC 9457 problem details on errors.</Description>
		<Authors>Gustavo Viana</Authors>
		<Company>Gustavo Viana</Company>
		<RepositoryUrl>https://github.com/gustavorviana/Viana.Results</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageProjectUrl>https://github.com/gustavorviana/Viana.Results</PackageProjectUrl>
		<PackageTags>result;results;aspnetcore;mvc;filters;viana</PackageTags>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>

		<!-- Packing configuration -->
		<IsPackable>true</IsPackable>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<Version>2.0.0</Version>
		<PackageReleaseNotes>
			BREAKING: serialized response shape changed. ListResult&lt;T&gt; is now emitted as a plain JSON array (was an object with "data"). Result&lt;T&gt; no longer emits the "status" or "problem" wrapper fields. PagedResult&lt;T&gt; keeps its metadata. Clients that depended on the wrapper shape must be updated.
			Removed redundant Microsoft.AspNetCore.Mvc.Core PackageReference (already covered by Microsoft.AspNetCore.App FrameworkReference). This also removes the transitive Newtonsoft.Json 9.0.1 vulnerability (NU1903).
		</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Viana.Results\Viana.Results.csproj" />
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<None Include=".\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>
