<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>

		<!-- NuGet package metadata -->
		<PackageId>Viana.Results.OpenApi</PackageId>
		<Title>Viana.Results.OpenApi</Title>
		<Description>OpenAPI integration for Viana.Results using Microsoft.AspNetCore.OpenApi transformers and shared schemas.</Description>
		<Authors>Gustavo Viana</Authors>
		<Company>Gustavo Viana</Company>
		<RepositoryUrl>https://github.com/gustavorviana/Viana.Results</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageProjectUrl>https://github.com/gustavorviana/Viana.Results</PackageProjectUrl>
		<PackageTags>result;results;openapi;viana</PackageTags>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>

		<!-- Packing configuration -->
		<IsPackable>true</IsPackable>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<Version>1.1.0</Version>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Viana.Results\Viana.Results.csproj" />
	</ItemGroup>

</Project>
