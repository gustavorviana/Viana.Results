<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>

		<!-- NuGet package metadata -->
		<PackageId>Viana.Results.OpenApi.Swashbuckle</PackageId>
		<Title>Viana.Results.OpenApi.Swashbuckle</Title>
		<Description>Swashbuckle.AspNetCore (10.x+) integration for Viana.Results: SwaggerGen filters that unwrap Result/ListResult/PagedResult schemas, emit RFC 9457 problem responses, support IExampleProvider&lt;T&gt; with [ResponseExample] attribute and global registration. For projects using AddOpenApi() directly (without Swashbuckle), see Viana.Results.OpenApi.</Description>
		<Authors>Gustavo Viana</Authors>
		<Company>Gustavo Viana</Company>
		<RepositoryUrl>https://github.com/gustavorviana/Viana.Results</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageProjectUrl>https://github.com/gustavorviana/Viana.Results</PackageProjectUrl>
		<PackageTags>result;results;openapi;swagger;swashbuckle;viana</PackageTags>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>

		<!-- Packing configuration -->
		<IsPackable>true</IsPackable>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<Version>1.1.0</Version>
		<PackageReleaseNotes>
			Targets Swashbuckle.AspNetCore 10.x (post Microsoft.OpenApi 3.x breaking change) only.
			Fixed Result&lt;T&gt;, ListResult&lt;T&gt; and PagedResult&lt;T&gt; OpenAPI schema mapping so the response shows the actual payload schema instead of the wrapper.
			Added [ResponseExample] attribute and IExampleProvider&lt;T&gt; for typed response examples (method/class/global precedence), backed by shared processors in Viana.Results.OpenApi.
		</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" />
		<PackageReference Include="Swashbuckle.AspNetCore" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Viana.Results\Viana.Results.csproj" />
		<ProjectReference Include="..\Viana.Results.OpenApi\Viana.Results.OpenApi.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Include=".\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>
