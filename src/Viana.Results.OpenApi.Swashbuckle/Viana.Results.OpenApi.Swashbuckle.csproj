<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>latest</LangVersion>

		<!-- NuGet package metadata -->
		<PackageId>Viana.Results.OpenApi.Swashbuckle</PackageId>
		<Title>Viana.Results.OpenApi.Swashbuckle</Title>
		<Description>Swashbuckle.AspNetCore (10.x+) integration for Viana.Results: SwaggerGen filters that unwrap Result/ListResult/PagedResult schemas, emit RFC 9457 problem responses, support IExampleProvider&lt;T&gt; with [ResponseExample] attribute and global registration. For projects using AddOpenApi() directly (without Swashbuckle), see Viana.Results.OpenApi.</Description>
		<Authors>Gustavo Viana</Authors>
		<Company>Gustavo Viana</Company>
		<RepositoryUrl>https://github.com/gustavorviana/Viana.Results</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageProjectUrl>https://github.com/gustavorviana/Viana.Results</PackageProjectUrl>
		<PackageTags>result;results;openapi;swagger;swashbuckle;viana</PackageTags>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>

		<!-- Packing configuration -->
		<IsPackable>true</IsPackable>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<Version>1.1.2</Version>
		<PackageReleaseNotes>
			Security: updated Microsoft.AspNetCore.OpenApi to 10.0.15 and Swashbuckle.AspNetCore to 10.3.1, which resolves the high-severity vulnerability in the transitive Microsoft.OpenApi dependency (GHSA-v5pm-xwqc-g5wc); Microsoft.OpenApi now resolves to 2.13.0.
			ProblemResultAttribute.Detail (from Viana.Results.OpenApi 1.1.0) is documented in the Swashbuckle output.
			Fixed: examples generated from [ProblemResult] are JSON objects with typed values (numbers/booleans no longer quoted, text correctly escaped).
			Fixed: the documented default problem title is the status reason phrase, matching the runtime (e.g. 404 "Not Found").
			Fixed: ValueTask&lt;T&gt; return types are handled like Task&lt;T&gt;.
			Fixed: 401/403 responses honor [AllowAnonymous] and are added for minimal API endpoints using RequireAuthorization().
			Fixed: schema member names are case-insensitive like the runtime (no member silently dropped).
			Fixed: unwrapping Result&lt;T&gt; response schemas keeps existing examples and media-type settings.
		</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" />
		<PackageReference Include="Swashbuckle.AspNetCore" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Viana.Results\Viana.Results.csproj" />
		<ProjectReference Include="..\Viana.Results.OpenApi\Viana.Results.OpenApi.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Include=".\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>
