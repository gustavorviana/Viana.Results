# Catalog requests. Same file works for the Swagger host: change @host to http://localhost:5026.
# Switch @api between the controller (/api/products) and minimal API (/minimal/products) styles.
@host = http://localhost:5027
@api = {{host}}/api/products
# @api = {{host}}/minimal/products

### List (200)
GET {{api}}

### Get (200)
GET {{api}}/1

### Get missing (404 problem)
GET {{api}}/99

### Create (201)
POST {{api}}
Content-Type: application/json

{ "sku": "HS-001", "name": "Headset", "price": 499.0, "stock": 5 }

### Create with the same SKU, any case (409 problem)
POST {{api}}
Content-Type: application/json

{ "sku": "kb-001", "name": "Another keyboard", "price": 10, "stock": 1 }

### Create invalid (400 validation problem, one error per field)
POST {{api}}
Content-Type: application/json

{ "sku": "", "name": "", "price": 0, "stock": -1 }

### Create malformed JSON (400 problem)
POST {{api}}
Content-Type: application/json

{ not json

### Update (204)
PUT {{api}}/2
Content-Type: application/json

{ "sku": "MS-002", "name": "Wireless mouse v2", "price": 139.9, "stock": 20 }

### Update missing (404 problem)
PUT {{api}}/99
Content-Type: application/json

{ "sku": "XX-001", "name": "Ghost", "price": 1, "stock": 0 }

### Delete with stock (422 business rule)
DELETE {{api}}/1

### Delete without stock (204)
DELETE {{api}}/3

### Stock (200)
GET {{api}}/1/stock

### Inventory down
POST {{host}}/api/inventory/availability?available=false

### Stock while inventory is down (503 problem with retryAfterSeconds)
GET {{api}}/1/stock

### Inventory back up
POST {{host}}/api/inventory/availability?available=true

### Viana.Results.Mvc controller (200 / 404)
GET {{host}}/api/legacy/products/1

###
GET {{host}}/api/legacy/products/99

