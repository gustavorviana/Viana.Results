{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Mediator": {
    "HandlerLifetime": "Scoped",
    "Telemetry": {
      "Tracing": true,
      "Metrics": true,
      "ExceptionDetails": "Full"
    },
    "ConsoleExporter": true
  }
}
